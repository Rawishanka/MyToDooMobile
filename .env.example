EXPO_PUBLIC_API_URL=http://YOUR_BACKEND_IP:5001/api
API_URL=http://YOUR_BACKEND_IP:5001/api

# Mapbox Configuration
EXPO_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
REACT_APP_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Alternative URLs for different platforms:
# Android Emulator: http://10.0.2.2:5001/api
# iOS Simulator: http://localhost:5001/api  
# Physical devices: http://192.168.1.3:5001/api
# Mock mode for development: mock

# ======================================
# Backend .env Configuration
# ======================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/Airtasker
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/taskhub?retryWrites=true&w=majority

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Secret (use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (NodeMailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
# For Gmail: Enable 2FA and generate an app-specific password
# Guide: https://support.google.com/accounts/answer/185833

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
# Get from: https://www.twilio.com/console

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# Google Sign-In Configuration
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Ratify AI Configuration
RATIFY_API_KEY=your_ratify_api_key

# Google Gemini AI Configuration (for OCR validation)
EXPO_PUBLIC_GEMINI_API_KEY=AIzaSyDXwrlxAxWatULLB91jC6zZalkz4XeHzdU

# AWS S3 Configuration (Optional - for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# Other Configuration
ENVIRONMENT=development
