{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "default",
        "simulator": true
      }
    },
    "preview": {
      "node": "20.18.0",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "scheme": "MyToDoo",
        "credentialsSource": "local"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mytodoo.com/api"
      },
      "channel": "preview"
    },
    "production": {
      "node": "20.18.0",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "credentialsSource": "local",
        "buildConfiguration": "Release"
      },
      "env": {
        "_comment": "This URL is set specifically for production builds. For local development, change the .env file instead.",
        "EXPO_PUBLIC_API_URL": "https://api.mytodoo.com/api"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
